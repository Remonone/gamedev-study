      _displayName: Generated per second
    - _statisticId: documents.processed_per_second
      _displayName: Processed per second
    - _statisticId: documents.consumed_per_second
      _displayName: Consumed per second
    - _statisticId: documents.generated_total
      _displayName: Total generated
    - _statisticId: documents.consumed_total
      _displayName: Total consumed
